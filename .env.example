# Copy this file to .env and replace every placeholder.
#   cp .env.example .env
# Never commit .env. Values below are examples only — not real credentials.
#
# Required names used by the app (src/app.js, src/config/database.js, auth):
#   NODE_ENV, PORT
#   DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD, DB_SYNC
#   JWT_SECRET, JWT_REFRESH_SECRET, JWT_EXPIRES_IN, JWT_REFRESH_EXPIRES_IN
# Optional names:
#   WORK_START_TIME, WORK_END_TIME, UPLOAD_PATH, DOCUMENT_UPLOAD_PATH,
#   AVATAR_UPLOAD_PATH, UPLOAD_DIR, MAX_FILE_SIZE, LOG_LEVEL, LOG_DIR,
#   RATE_LIMIT_WINDOW_MS, RATE_LIMIT_MAX, SERVER_TIMEOUT
#   OSS_* and MAIL_* if those integrations are enabled
#
# Generate JWT secrets locally, for example:
#   openssl rand -hex 32

# --- Required: app ---
NODE_ENV=development
PORT=3002

# --- Required: MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=workflow
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_SYNC=true
# Optional: node init-db.js --force or INIT_DB_FORCE=true rebuilds the database (destroys data)
# INIT_DB_FORCE=false

# --- Required: JWT (placeholders only; replace with long random strings) ---
JWT_SECRET=replace_with_long_random_string
JWT_REFRESH_SECRET=replace_with_another_long_random_string
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# --- Optional: work hours ---
WORK_START_TIME=09:00:00
WORK_END_TIME=18:00:00

# --- Optional: uploads ---
UPLOAD_PATH=./uploads
DOCUMENT_UPLOAD_PATH=uploads/documents
AVATAR_UPLOAD_PATH=uploads/avatars
MAX_FILE_SIZE=10485760

# --- Optional: logging ---
LOG_LEVEL=debug
LOG_DIR=./logs

# --- Optional: rate limit / timeout (documented; some are currently hardcoded in app.js) ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
SERVER_TIMEOUT=120000

# --- Optional: Aliyun OSS (uncomment to use) ---
# OSS_REGION=oss-cn-hangzhou
# OSS_ACCESS_KEY_ID=your_access_key_id
# OSS_ACCESS_KEY_SECRET=your_access_key_secret
# OSS_BUCKET=your-bucket-name

# --- Optional: mail (uncomment to use) ---
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USER=user@example.com
# MAIL_PASS=your_smtp_password
# MAIL_FROM=noreply@example.com
